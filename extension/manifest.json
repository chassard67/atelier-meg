{
  "manifest_version": 3,
  "name": "Atelier MEG",
  "short_name": "Atelier MEG",
  "version": "2.1.0",
  "description": "Outils pour Mon Expert en Gestion (MEG). Les modules et l'extension elle-même se mettent à jour automatiquement depuis GitHub.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "userScripts",
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "downloads.open",
    "scripting",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mon-expert-en-gestion.fr/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atelier MEG",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
